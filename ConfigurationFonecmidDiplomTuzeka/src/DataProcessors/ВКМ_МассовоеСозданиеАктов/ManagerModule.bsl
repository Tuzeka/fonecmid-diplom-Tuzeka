#Область ПрограммныйИнтерфейс

// Создаёт документы РеализацияТоваровУслуг за период по договорам абонентского обслуживания,
// по которым реализация ещё не создана, и помещает таблицу результатов во временное хранилище.
//
// Параметры:
//  Параметры - Структура:
//   * Период - Дата - период, за который создаются акты.
//  АдресРезультата - Строка - адрес временного хранилища для таблицы результатов.
Процедура ВКМ_СоздатьАкты(Параметры, АдресРезультата) Экспорт

	Период = Параметры.Период;
	НачалоПериода = НачалоМесяца(Период);
	КонецПериода = КонецМесяца(Период);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВКМ_Договор");
	Результат.Колонки.Добавить("ВКМ_Реализация");
	Результат.Колонки.Добавить("ВКМ_Статус");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.ВКМ_ДатаНачала <= &КонецПериода
	|	И ДоговорыКонтрагентов.ВКМ_ДатаОкончания >= &НачалоПериода";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	РезультатДоговоров = Запрос.Выполнить();
	МассивДоговоров = РезультатДоговоров.Выгрузить().ВыгрузитьКолонку("Ссылка");
	ВыборкаДоговоры = РезультатДоговоров.Выбрать();

	РеализацииПоДоговорам = ВКМ_СформироватьРеализацииПоДоговорам(МассивДоговоров, НачалоПериода, КонецПериода);

	Пока ВыборкаДоговоры.Следующий() Цикл

		Договор = ВыборкаДоговоры.Ссылка;

		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.ВКМ_Договор = Договор;

		СуществующаяРеализация = РеализацииПоДоговорам.Получить(Договор);

		Если ЗначениеЗаполнено(СуществующаяРеализация) Тогда
			СтрокаРезультата.ВКМ_Реализация = СуществующаяРеализация;
			СтрокаРезультата.ВКМ_Статус = "Уже создана";
			Продолжить;
		КонецЕсли;

		НовыйДокумент = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		НовыйДокумент.Дата = КонецПериода;
		НовыйДокумент.Организация = Договор.Организация;
		НовыйДокумент.Контрагент = Договор.Владелец;
		НовыйДокумент.Договор = Договор;
		НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();

		Попытка
			НовыйДокумент.ВКМ_ВыполнитьАвтозаполнение();
		Исключение
			СтрокаРезультата.ВКМ_Статус =
				"Ошибка автозаполнения: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;

		НовыйДокумент.СуммаДокумента = НовыйДокумент.Товары.Итог("Сумма") + НовыйДокумент.Услуги.Итог("Сумма");

		Если Не НовыйДокумент.ПроверитьЗаполнение() Тогда
			СтрокаРезультата.ВКМ_Статус = "Не заполнены обязательные поля документа";
			Продолжить;
		КонецЕсли;

		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			СтрокаРезультата.ВКМ_Реализация = НовыйДокумент.Ссылка;
			СтрокаРезультата.ВКМ_Статус = "Создана";
		Исключение
			СтрокаРезультата.ВКМ_Статус =
				"Ошибка проведения: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВКМ_СформироватьРеализацииПоДоговорам(МассивДоговоров, НачалоПериода, КонецПериода)

	РеализацииПоДоговорам = Новый Соответствие;

	Если МассивДоговоров.Количество() = 0 Тогда
		Возврат РеализацииПоДоговорам;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Договор КАК Договор,
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Договор В (&МассивДоговоров)
	|	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления";
	Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если РеализацииПоДоговорам.Получить(Выборка.Договор) = Неопределено Тогда
			РеализацииПоДоговорам.Вставить(Выборка.Договор, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат РеализацииПоДоговорам;

КонецФункции

#КонецОбласти

#КонецЕсли
