
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ТекстУведомления = "";

	Если Ссылка.Пустая() Тогда
		ТекстУведомления = "Новая заявка на обслуживание: " + ВКМ_ТекстУведомления();
	Иначе
		СтарыеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
			"ВКМ_ДатаПроведенияРабот, ВКМ_ВремяНачалаРабот, ВКМ_ВремяОкончанияРабот, ВКМ_Специалист");

		ДанныеРаботИзменились = СтарыеЗначения.ВКМ_ДатаПроведенияРабот <> ВКМ_ДатаПроведенияРабот
			Или СтарыеЗначения.ВКМ_ВремяНачалаРабот <> ВКМ_ВремяНачалаРабот
			Или СтарыеЗначения.ВКМ_ВремяОкончанияРабот <> ВКМ_ВремяОкончанияРабот
			Или СтарыеЗначения.ВКМ_Специалист <> ВКМ_Специалист;

		Если ДанныеРаботИзменились Тогда
			ТекстУведомления = "Изменена заявка на обслуживание: " + ВКМ_ТекстУведомления();
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстУведомления) Тогда
		Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
		Уведомление.ВКМ_ТекстСообщения = ТекстУведомления;
		Уведомление.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ДанныеДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВКМ_Договор,
		"ВидДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания, ВКМ_СтавкаЧасаРаботы");
	Если ДанныеДоговора.ВКМ_СтавкаЧасаРаботы = NULL Тогда
		ДанныеДоговора.ВКМ_СтавкаЧасаРаботы = 0;
	КонецЕсли;

	Если ДанныеДоговора.ВидДоговора
		<> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание")
		Или Дата < ДанныеДоговора.ВКМ_ДатаНачала
		Или Дата > ДанныеДоговора.ВКМ_ДатаОкончания Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	УсловияОплаты = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
		Дата,
		Новый Структура("ВКМ_Сотрудник", ВКМ_Специалист));

	Если УсловияОплаты.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПроцентОтРабот = УсловияОплаты[0].ВКМ_ПроцентОтРабот;
	СтоПроцентов = 100;

	ЧасовКОплате = ВКМ_ВыполненныеРаботы.Итог("ВКМ_ЧасыКОплате");
	СуммаКОплатеКлиентом = ЧасовКОплате * ДанныеДоговора.ВКМ_СтавкаЧасаРаботы;

	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;

	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
	Движение.Период = ВКМ_ДатаПроведенияРабот;
	Движение.ВКМ_Клиент = ВКМ_Клиент;
	Движение.ВКМ_Договор = ВКМ_Договор;
	Движение.ВКМ_КоличествоЧасов = ЧасовКОплате;
	Движение.ВКМ_СуммаКОплате = СуммаКОплатеКлиентом;

	Движение = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
	Движение.Период = ВКМ_ДатаПроведенияРабот;
	Движение.ВКМ_Сотрудник = ВКМ_Специалист;
	Движение.ВКМ_ЧасовКОплате = ЧасовКОплате;
	Движение.ВКМ_СуммаКОплате = СуммаКОплатеКлиентом * ПроцентОтРабот / СтоПроцентов;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВКМ_ТекстУведомления()

	Возврат "" + ВКМ_Специалист + ", "
		+ Формат(ВКМ_ДатаПроведенияРабот, "ДФ=дд.ММ.гггг") + " "
		+ Формат(ВКМ_ВремяНачалаРабот, "ДФ=ЧЧ:мм") + "-" + Формат(ВКМ_ВремяОкончанияРабот, "ДФ=ЧЧ:мм")
		+ ", клиент " + ВКМ_Клиент;

КонецФункции

#КонецОбласти

#КонецЕсли
