
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	НачалоПериода = НачалоМесяца(ВКМ_МесяцНачисления);
	КонецПериода = КонецМесяца(ВКМ_МесяцНачисления);
	НачалоБазовогоПериода = НачалоМесяца(ДобавитьМесяц(НачалоПериода, -12));
	КонецБазовогоПериода = КонецМесяца(ДобавитьМесяц(НачалоПериода, -1));

	ВКМ_ПроизводственныйКалендарь.ВКМ_ЗаполнитьГрафикРаботы(НачалоБазовогоПериода, КонецПериода);

	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	ОкладыПоНомерамСтрок = ЗаполнитьОсновныеНачисления(
		НачалоПериода, КонецПериода, НачалоБазовогоПериода, КонецБазовогоПериода);
	РассчитатьОкладыИОтпускные(ОкладыПоНомерамСтрок);

	ЗаполнитьУдержания(НачалоПериода, КонецПериода);
	РассчитатьНДФЛ();

	ЗаполнитьВзаиморасчеты(НачалоПериода);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьОсновныеНачисления(НачалоПериода, КонецПериода, НачалоБазовогоПериода, КонецБазовогоПериода)

	ВидРасчетаОклад = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Оклад");
	ВидРасчетаОтпускные = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Отпускные");
	ВидРасчетаПроцентОтРабот = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_ПроцентОтРабот");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ВКМ_Категория КАК Категория
	|ИЗ
	|	Справочник.ВКМ_Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления";
	ВыборкаСотрудников = Запрос.Выполнить().Выбрать();

	ОтпускаСотрудников = ПолучитьОтпускаСотрудников(НачалоПериода, КонецПериода);
	ОкладыПоНомерамСтрок = Новый Соответствие;

	Пока ВыборкаСотрудников.Следующий() Цикл

		УсловияОплаты = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
			КонецПериода,
			Новый Структура("ВКМ_Сотрудник", ВыборкаСотрудников.Сотрудник));

		Если УсловияОплаты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ДвижениеОклад = Движения.ВКМ_ОсновныеНачисления.Добавить();
		ДвижениеОклад.ПериодРегистрации = НачалоПериода;
		ДвижениеОклад.ВидРасчета = ВидРасчетаОклад;
		ДвижениеОклад.ВКМ_Сотрудник = ВыборкаСотрудников.Сотрудник;
		ДвижениеОклад.ПериодДействияНачало = НачалоПериода;
		ДвижениеОклад.ПериодДействияКонец = КонецПериода;
		ОкладыПоНомерамСтрок.Вставить(Движения.ВКМ_ОсновныеНачисления.Количество(), УсловияОплаты[0].ВКМ_Оклад);

		ОтборОтпусков = Новый Структура("Сотрудник", ВыборкаСотрудников.Сотрудник);
		Для Каждого СтрокаОтпуска Из ОтпускаСотрудников.НайтиСтроки(ОтборОтпусков) Цикл

			ДвижениеОтпускные = Движения.ВКМ_ОсновныеНачисления.Добавить();
			ДвижениеОтпускные.ПериодРегистрации = НачалоПериода;
			ДвижениеОтпускные.ВидРасчета = ВидРасчетаОтпускные;
			ДвижениеОтпускные.ВКМ_Сотрудник = ВыборкаСотрудников.Сотрудник;
			ДвижениеОтпускные.ПериодДействияНачало = Макс(СтрокаОтпуска.ДатаНачала, НачалоПериода);
			ДвижениеОтпускные.ПериодДействияКонец = Мин(КонецДня(СтрокаОтпуска.ДатаОкончания), КонецПериода);
			ДвижениеОтпускные.БазовыйПериодНачало = НачалоБазовогоПериода;
			ДвижениеОтпускные.БазовыйПериодКонец = КонецБазовогоПериода;

		КонецЦикла;

		Если ВыборкаСотрудников.Категория =
			ПредопределенноеЗначение("Перечисление.ВКМ_КатегорииСотрудников.ВКМ_Специалист") Тогда

			ОтборПоСотруднику = Новый Структура("ВКМ_Сотрудник", ВыборкаСотрудников.Сотрудник);
			ОборотыРабот = РегистрыНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(
				НачалоПериода, КонецПериода, ОтборПоСотруднику);

			Если ОборотыРабот.Количество() > 0 Тогда
				ДвижениеПроцент = Движения.ВКМ_ОсновныеНачисления.Добавить();
				ДвижениеПроцент.ПериодРегистрации = НачалоПериода;
				ДвижениеПроцент.ВидРасчета = ВидРасчетаПроцентОтРабот;
				ДвижениеПроцент.ВКМ_Сотрудник = ВыборкаСотрудников.Сотрудник;
				ДвижениеПроцент.ВКМ_Результат = ОборотыРабот[0].ВКМ_СуммаКОплате;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат ОкладыПоНомерамСтрок;

КонецФункции

Процедура РассчитатьОкладыИОтпускные(ОкладыПоНомерамСтрок)

	ВидРасчетаОклад = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Оклад");
	ВидРасчетаОтпускные = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Отпускные");

	НаборЗаписей = Движения.ВКМ_ОсновныеНачисления;
	НаборЗаписей.Записать();

	ДанныеГрафика = ПолучитьДанныеГрафика();
	БазаОтпускных = ПолучитьБазуОтпускных();
	ДниОтпуска = ПолучитьДниОтпускаПоСотрудникам(НаборЗаписей, ВидРасчетаОтпускные);

	Для Индекс = 0 По НаборЗаписей.Количество() - 1 Цикл

		Движение = НаборЗаписей[Индекс];
		НомерСтроки = Индекс + 1;

		ДанныеСтроки = ДанныеГрафика.Получить(НомерСтроки);
		Если ДанныеСтроки = Неопределено Тогда
			ДанныеСтроки = Новый Структура("ЗначениеПериодДействия, ЗначениеБазовыйПериод", 0, 0);
		КонецЕсли;

		Если Движение.ВидРасчета = ВидРасчетаОклад Тогда
			Движение.ВКМ_Результат = РассчитатьОклад(
				ОкладыПоНомерамСтрок.Получить(НомерСтроки), ДанныеСтроки, ДниОтпуска.Получить(Движение.ВКМ_Сотрудник));
		ИначеЕсли Движение.ВидРасчета = ВидРасчетаОтпускные Тогда
			Движение.ВКМ_Результат = РассчитатьОтпускные(Движение, БазаОтпускных.Получить(НомерСтроки), ДанныеСтроки);
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать();

КонецПроцедуры

Функция РассчитатьОклад(Оклад, ДанныеСтроки, ДниОтпуска)

	Если ДанныеСтроки.ЗначениеПериодДействия = 0 Тогда
		Возврат Оклад;
	КонецЕсли;

	РабочихДней = Макс(ДанныеСтроки.ЗначениеПериодДействия - ?(ДниОтпуска = Неопределено, 0, ДниОтпуска), 0);

	Возврат Окр(Оклад * РабочихДней / ДанныеСтроки.ЗначениеПериодДействия, 2);

КонецФункции

Функция РассчитатьОтпускные(Движение, СуммаБазы, ДанныеСтроки)

	Если СуммаБазы = Неопределено Или ДанныеСтроки.ЗначениеБазовыйПериод = 0 Тогда
		Возврат 0;
	КонецЕсли;

	СреднедневнойЗаработок = СуммаБазы / ДанныеСтроки.ЗначениеБазовыйПериод;
	КалендарныхДнейОтпуска = ВКМ_ПроизводственныйКалендарь.ВКМ_КоличествоКалендарныхДней(
		Движение.ПериодДействияНачало, Движение.ПериодДействияКонец);

	Возврат Окр(СреднедневнойЗаработок * КалендарныхДнейОтпуска, 2);

КонецФункции

Процедура ЗаполнитьУдержания(НачалоПериода, КонецПериода)

	ВидРасчетаНДФЛ = ПредопределенноеЗначение("ПланВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ");

	Для Каждого Сотрудник Из ПолучитьСотрудниковНачислений() Цикл

		ДвижениеНДФЛ = Движения.ВКМ_Удержания.Добавить();
		ДвижениеНДФЛ.ПериодРегистрации = НачалоПериода;
		ДвижениеНДФЛ.ВидРасчета = ВидРасчетаНДФЛ;
		ДвижениеНДФЛ.ВКМ_Сотрудник = Сотрудник;
		ДвижениеНДФЛ.БазовыйПериодНачало = НачалоПериода;
		ДвижениеНДФЛ.БазовыйПериодКонец = КонецПериода;

	КонецЦикла;

КонецПроцедуры

Процедура РассчитатьНДФЛ()

	СтавкаНДФЛ = 0.13;

	НаборЗаписей = Движения.ВКМ_Удержания;
	НаборЗаписей.Записать();

	БазаНДФЛ = ПолучитьБазуНДФЛ();

	Для Индекс = 0 По НаборЗаписей.Количество() - 1 Цикл

		СуммаБазы = БазаНДФЛ.Получить(Индекс + 1);
		Если СуммаБазы = Неопределено Тогда
			СуммаБазы = 0;
		КонецЕсли;

		НаборЗаписей[Индекс].ВКМ_Результат = Окр(СуммаБазы * СтавкаНДФЛ, 2);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВзаиморасчеты(НачалоПериода)

	НачисленоПоСотрудникам = ПолучитьСуммыПоСотрудникам(Движения.ВКМ_ОсновныеНачисления);
	УдержаноПоСотрудникам = ПолучитьСуммыПоСотрудникам(Движения.ВКМ_Удержания);

	Для Каждого Сотрудник Из ПолучитьСотрудниковНачислений() Цикл

		ДвижениеВзаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчеты.Период = НачалоПериода;
		ДвижениеВзаиморасчеты.ВКМ_Сотрудник = Сотрудник;
		ДвижениеВзаиморасчеты.ВКМ_Сумма =
			НачисленоПоСотрудникам.Получить(Сотрудник) - УдержаноПоСотрудникам.Получить(Сотрудник);

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСотрудниковНачислений()

	Сотрудники = Новый Массив;
	ДобавленныеСотрудники = Новый Соответствие;

	Для Каждого Запись Из Движения.ВКМ_ОсновныеНачисления Цикл

		Если ДобавленныеСотрудники.Получить(Запись.ВКМ_Сотрудник) = Неопределено Тогда
			ДобавленныеСотрудники.Вставить(Запись.ВКМ_Сотрудник, Истина);
			Сотрудники.Добавить(Запись.ВКМ_Сотрудник);
		КонецЕсли;

	КонецЦикла;

	Возврат Сотрудники;

КонецФункции

Функция ПолучитьСуммыПоСотрудникам(НаборЗаписей)

	СуммыПоСотрудникам = Новый Соответствие;

	Для Каждого Запись Из НаборЗаписей Цикл

		Сумма = СуммыПоСотрудникам.Получить(Запись.ВКМ_Сотрудник);
		Если Сумма = Неопределено Тогда
			Сумма = 0;
		КонецЕсли;

		СуммыПоСотрудникам.Вставить(Запись.ВКМ_Сотрудник, Сумма + Запись.ВКМ_Результат);

	КонецЦикла;

	Возврат СуммыПоСотрудникам;

КонецФункции

Функция ПолучитьОтпускаСотрудников(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отпуска.ВКМ_Сотрудник КАК Сотрудник,
	|	Отпуска.ВКМ_ДатаНачала КАК ДатаНачала,
	|	Отпуска.ВКМ_ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Документ.ВКМ_ГрафикОтпусков.ВКМ_ОтпускаСотрудников КАК Отпуска
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВКМ_ГрафикОтпусков КАК ГрафикОтпусков
	|		ПО Отпуска.Ссылка = ГрафикОтпусков.Ссылка
	|ГДЕ
	|	ГрафикОтпусков.Проведен
	|	И Отпуска.ВКМ_ДатаНачала <= &КонецПериода
	|	И Отпуска.ВКМ_ДатаОкончания >= &НачалоПериода";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьДанныеГрафика()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеГрафика.НомерСтроки КАК НомерСтроки,
	|	СУММА(ЕСТЬNULL(ДанныеГрафика.ВКМ_КоэффициентПериодДействия, 0)) КАК ЗначениеПериодДействия,
	|	СУММА(ЕСТЬNULL(ДанныеГрафика.ВКМ_КоэффициентБазовыйПериод, 0)) КАК ЗначениеБазовыйПериод
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(Регистратор = &Регистратор) КАК ДанныеГрафика
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеГрафика.НомерСтроки";
	Запрос.УстановитьПараметр("Регистратор", Ссылка);

	ДанныеГрафика = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("ЗначениеПериодДействия", Выборка.ЗначениеПериодДействия);
		ДанныеСтроки.Вставить("ЗначениеБазовыйПериод", Выборка.ЗначениеБазовыйПериод);
		ДанныеГрафика.Вставить(Выборка.НомерСтроки, ДанныеСтроки);

	КонецЦикла;

	Возврат ДанныеГрафика;

КонецФункции

Функция ПолучитьБазуОтпускных()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БазаОтпускных.НомерСтроки КАК НомерСтроки,
	|	СУММА(БазаОтпускных.ВКМ_РезультатБаза) КАК СуммаБазы
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления.БазаВКМ_ОсновныеНачисления(
	|			&ИзмеренияОсновногоРегистра,
	|			&ИзмеренияБазовогоРегистра,
	|			,
	|			Регистратор = &Регистратор) КАК БазаОтпускных
	|
	|СГРУППИРОВАТЬ ПО
	|	БазаОтпускных.НомерСтроки";
	Запрос.УстановитьПараметр("ИзмеренияОсновногоРегистра", ИзмеренияСвязиБазы());
	Запрос.УстановитьПараметр("ИзмеренияБазовогоРегистра", ИзмеренияСвязиБазы());
	Запрос.УстановитьПараметр("Регистратор", Ссылка);

	Возврат ПолучитьСуммыБазыПоНомерамСтрок(Запрос);

КонецФункции

Функция ПолучитьБазуНДФЛ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БазаНДФЛ.НомерСтроки КАК НомерСтроки,
	|	СУММА(БазаНДФЛ.ВКМ_РезультатБаза) КАК СуммаБазы
	|ИЗ
	|	РегистрРасчета.ВКМ_Удержания.БазаВКМ_ОсновныеНачисления(
	|			&ИзмеренияОсновногоРегистра,
	|			&ИзмеренияБазовогоРегистра,
	|			,
	|			Регистратор = &Регистратор) КАК БазаНДФЛ
	|
	|СГРУППИРОВАТЬ ПО
	|	БазаНДФЛ.НомерСтроки";
	Запрос.УстановитьПараметр("ИзмеренияОсновногоРегистра", ИзмеренияСвязиБазы());
	Запрос.УстановитьПараметр("ИзмеренияБазовогоРегистра", ИзмеренияСвязиБазы());
	Запрос.УстановитьПараметр("Регистратор", Ссылка);

	Возврат ПолучитьСуммыБазыПоНомерамСтрок(Запрос);

КонецФункции

Функция ПолучитьДниОтпускаПоСотрудникам(НаборЗаписей, ВидРасчетаОтпускные)

	ДниОтпуска = Новый Соответствие;

	Для Каждого Запись Из НаборЗаписей Цикл

		Если Запись.ВидРасчета <> ВидРасчетаОтпускные Тогда
			Продолжить;
		КонецЕсли;

		Дни = ДниОтпуска.Получить(Запись.ВКМ_Сотрудник);
		Если Дни = Неопределено Тогда
			Дни = 0;
		КонецЕсли;

		ДниОтпуска.Вставить(Запись.ВКМ_Сотрудник, Дни + ВКМ_ПроизводственныйКалендарь.ВКМ_СуммаКоэффициентовГрафика(
			Запись.ПериодДействияНачало, Запись.ПериодДействияКонец));

	КонецЦикла;

	Возврат ДниОтпуска;

КонецФункции

Функция ИзмеренияСвязиБазы()

	Измерения = Новый Массив;
	Измерения.Добавить("ВКМ_Сотрудник");

	Возврат Измерения;

КонецФункции

Функция ПолучитьСуммыБазыПоНомерамСтрок(Запрос)

	СуммыБазы = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммыБазы.Вставить(Выборка.НомерСтроки, Выборка.СуммаБазы);
	КонецЦикла;

	Возврат СуммыБазы;

КонецФункции

#КонецОбласти

#КонецЕсли
