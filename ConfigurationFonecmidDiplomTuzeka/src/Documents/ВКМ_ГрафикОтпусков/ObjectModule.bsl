
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ВКМ_ЗапланированныеОтпуска.Записывать = Истина;

	КалендарныхДнейПоСотрудникам = Новый Соответствие;

	ПарыСотрудникМесяц = Новый ТаблицаЗначений;
	ПарыСотрудникМесяц.Колонки.Добавить("Сотрудник");
	ПарыСотрудникМесяц.Колонки.Добавить("Месяц");

	Для Каждого СтрокаОтпуска Из ВКМ_ОтпускаСотрудников Цикл

		КоличествоДней = ВКМ_ПроизводственныйКалендарь.ВКМ_КоличествоКалендарныхДней(
			СтрокаОтпуска.ВКМ_ДатаНачала, СтрокаОтпуска.ВКМ_ДатаОкончания);

		Если КалендарныхДнейПоСотрудникам[СтрокаОтпуска.ВКМ_Сотрудник] = Неопределено Тогда
			КалендарныхДнейПоСотрудникам.Вставить(СтрокаОтпуска.ВКМ_Сотрудник, КоличествоДней);
		Иначе
			КалендарныхДнейПоСотрудникам[СтрокаОтпуска.ВКМ_Сотрудник] =
				КалендарныхДнейПоСотрудникам[СтрокаОтпуска.ВКМ_Сотрудник] + КоличествоДней;
		КонецЕсли;

		ТекущийМесяц = НачалоМесяца(СтрокаОтпуска.ВКМ_ДатаНачала);
		ПоследнийМесяц = НачалоМесяца(СтрокаОтпуска.ВКМ_ДатаОкончания);
		Пока ТекущийМесяц <= ПоследнийМесяц Цикл
			НоваяПара = ПарыСотрудникМесяц.Добавить();
			НоваяПара.Сотрудник = СтрокаОтпуска.ВКМ_Сотрудник;
			НоваяПара.Месяц = ТекущийМесяц;
			ТекущийМесяц = ДобавитьМесяц(ТекущийМесяц, 1);
		КонецЦикла;

	КонецЦикла;

	ЗарегистрироватьПерерасчетПриНеобходимости(ПарыСотрудникМесяц);

	Для Каждого ЭлементСотрудника Из КалендарныхДнейПоСотрудникам Цикл

		Движение = Движения.ВКМ_ЗапланированныеОтпуска.Добавить();
		Движение.Период = Дата(ВКМ_Год, 1, 1);
		Движение.ВКМ_Сотрудник = ЭлементСотрудника.Ключ;
		Движение.ВКМ_Год = ВКМ_Год;
		Движение.ВКМ_КалендарныхДней = ЭлементСотрудника.Значение;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьПерерасчетПриНеобходимости(ПарыСотрудникМесяц)

	Если ПарыСотрудникМесяц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеНачисления.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления КАК ОсновныеНачисления
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ &ПарыСотрудникМесяц КАК Пары
	|		ПО ОсновныеНачисления.ВКМ_Сотрудник = Пары.Сотрудник
	|			И ОсновныеНачисления.ПериодРегистрации = Пары.Месяц";
	Запрос.УстановитьПараметр("ПарыСотрудникМесяц", ПарыСотрудникМесяц);

	ВыборкаРегистраторов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаРегистраторов.Следующий() Цикл

		НаборЗаписей = РегистрыРасчета.ВКМ_ОсновныеНачисления.Перерасчеты.ВКМ_ПерерасчетОсновныхНачислений
			.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОбъектПерерасчета.Значение = ВыборкаРегистраторов.Регистратор;
		НаборЗаписей.Отбор.ОбъектПерерасчета.Использование = Истина;
		НаборЗаписей.Прочитать();

		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ОбъектПерерасчета = ВыборкаРегистраторов.Регистратор;
			НаборЗаписей.Записать();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
