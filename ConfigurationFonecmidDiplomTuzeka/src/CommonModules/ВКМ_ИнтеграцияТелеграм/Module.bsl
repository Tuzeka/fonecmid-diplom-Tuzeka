
#Область ПрограммныйИнтерфейс

// Отправляет текстовое сообщение в группу Telegram через бота, используя токен и идентификатор
// группы оповещения, заданные в константах.
//
// Параметры:
//  Текст - Строка - текст отправляемого сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение успешно отправлено.
Функция ВКМ_ОтправитьСообщение(Текст) Экспорт

	Токен = Константы.ВКМ_ТокенТелеграмБота.Получить();
	ИдентификаторГруппы = Константы.ВКМ_ИдентификаторГруппыОповещения.Получить();

	Если ПустаяСтрока(Токен) Или ПустаяСтрока(ИдентификаторГруппы) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПортСоединения = 443;
	ТаймаутСекунд = 30;
	КодУспешногоОтвета = 200;
	Соединение = Новый HTTPСоединение("api.telegram.org", ПортСоединения, , , , ТаймаутСекунд, Истина);

	ПараметрыЗапроса = "chat_id=" + ИдентификаторГруппы
		+ "&text=" + КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);

	ЗапросHTTP = Новый HTTPЗапрос("/bot" + Токен + "/sendMessage?" + ПараметрыЗапроса);

	Попытка
		ОтветHTTP = Соединение.Получить(ЗапросHTTP);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат ОтветHTTP.КодСостояния = КодУспешногоОтвета;

КонецФункции

// Отправляет все накопленные в очереди уведомления в Telegram и удаляет из справочника те,
// что были успешно отправлены.
Процедура ВКМ_ОбработатьОчередьУведомлений() Экспорт

	Выборка = Справочники.ВКМ_УведомленияТелеграмБоту.Выбрать();

	Пока Выборка.Следующий() Цикл

		Если ВКМ_ОтправитьСообщение(Выборка.ВКМ_ТекстСообщения) Тогда
			Элемент = Выборка.ПолучитьОбъект();
			Элемент.Удалить();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
